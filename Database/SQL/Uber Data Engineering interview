Select top 3 
d.driver_id,
    d.name,
    AVG(t.rating) AS avg_rating,
    COUNT(t.trip_id) AS trip_count
from drivers as d 
JOIN trips as t ON t.driver_id = d.driver_id
group by d.driver_id,  d.name
having count(t.driver_id) >= 5
order by  avg(t.rating) Desc;

